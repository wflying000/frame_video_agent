# Chat Completions 基础地址；程序会追加 /chat/completions，不使用 /anthropic 接口。
# 以下值沿用代码默认配置；请按实际服务与模型权限修改。
# 模型必须同时支持 JSON 对象输出与实际多图输入，供生成和视觉审核共用。
LLM_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# 不支持 thinking 字段的服务可将 LLM_EXTRA_BODY 改成 '{}'。
# 不支持流式时可使用 '{"stream":false}'；输出额度按服务限制配置。
# LLM_IDLE_TIMEOUT_SECONDS=180
# LLM_SHOW_OUTPUT=1
